---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  size: string;
  icon?: string;
}

const { title, description, href, size, icon = 'file' } = Astro.props;
---

<a href={href} download class="card card-hover group flex items-start gap-4 p-6">
  <span
    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-accent/40 bg-accent/10 text-accent transition group-hover:bg-accent group-hover:text-base"
  >
    <Icon name={icon} class="h-6 w-6" />
  </span>
  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-3">
      <h3 class="font-semibold text-slate-100 group-hover:text-accent">{title}</h3>
      <span class="font-mono text-xs text-slate-500">{size}</span>
    </div>
    <p class="mt-1 text-sm text-slate-400">{description}</p>
    <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
      Download
      <Icon
        name="download"
        class="h-4 w-4 transition-transform group-hover:translate-y-0.5"
      />
    </span>
  </div>
</a>
