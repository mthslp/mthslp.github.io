---
import { site } from '../data/site';

const links = [
  { href: '/', label: 'Home' },
  { href: '/cv/', label: 'CV' },
  { href: '/skills/', label: 'Skills' },
  { href: '/documents/', label: 'Documents' },
  { href: '/contact/', label: 'Contact' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.replace(/\/$/, '') || '/';
  return clean === pathname;
};
---

<header class="sticky top-0 z-50 border-b border-line bg-base/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between">
    <a href="/" class="group flex items-center gap-2">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg border border-accent/50 bg-accent/10 font-mono text-sm font-semibold text-accent transition group-hover:bg-accent/20"
        >{site.name.slice(0, 1)}</span
      >
      <span class="font-semibold tracking-tight text-slate-100">{site.name}</span>
      <span class="hidden font-mono text-xs text-slate-500 sm:inline">.dev</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { 'nav-link-active': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <a href="/documents/" class="btn-primary">My CV</a>
    </div>

    <button
      id="menu-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line text-slate-300 md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"
        ><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path></svg
      >
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-line bg-base/95 px-4 py-4 md:hidden"
    aria-label="Mobile navigation"
  >
    <ul class="flex flex-col gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block rounded-lg px-3 py-2.5 text-sm transition',
                isActive(link.href)
                  ? 'bg-accent/10 text-accent'
                  : 'text-slate-400 hover:bg-card hover:text-slate-100',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/documents/" class="btn-primary mt-3 w-full">My CV</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
