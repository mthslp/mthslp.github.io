---
import Icon from './Icon.astro';

interface Props {
  name: string;
  description: string;
  tech: string[];
  year?: string;
  link?: string;
  github?: string;
}

const { name, description, tech, year, link, github } = Astro.props;
---

<article class="card card-hover flex h-full flex-col p-6">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-slate-100">{name}</h3>
    <div class="flex shrink-0 items-center gap-2">
      {
        year && (
          <span class="font-mono text-xs text-accent">{year}</span>
        )
      }
      <span class="flex gap-2 text-slate-500">
        {
          link && (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open project ${name}`}
              class="transition hover:text-accent"
            >
              <Icon name="external-link" class="h-4 w-4" />
            </a>
          )
        }
        {
          github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Source code of ${name}`}
              class="transition hover:text-accent"
            >
              <Icon name="github" class="h-4 w-4" />
            </a>
          )
        }
      </span>
    </div>
  </div>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-400">{description}</p>

  <ul class="mt-5 flex flex-wrap gap-2">
    {
      tech.map((t) => (
        <li class="rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-accent/90">
          {t}
        </li>
      ))
    }
  </ul>
</article>
