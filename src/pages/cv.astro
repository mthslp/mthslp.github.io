---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../data/site';
import fs from 'node:fs';
import path from 'node:path';

const entry = await getEntry('cv', 'cv');
if (!entry) throw new Error('Missing collection entry: src/content/cv.md');

const { Content } = await render(entry);
const { summary, experiences, education, languages, interests } = entry.data;

const cvPath = path.join(process.cwd(), 'public/docs/cv.pdf');
const hasCv = fs.existsSync(cvPath);
---

<BaseLayout
  title="CV"
  description="Professional experience, education and languages of Mathis Le Port — full CV online."
>
  <section class="border-b border-line bg-surface">
    <div class="container-page py-14">
      <p class="font-mono text-sm uppercase tracking-widest text-accent">Curriculum Vitae</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-100 sm:text-4xl">My background</h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-slate-400">{summary}</p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/cv/" class="btn-ghost" aria-current="page">Online version</a>
        {
          hasCv && (
            <a href="/docs/cv.pdf" download class="btn-primary">
              <Icon name="download" class="h-4 w-4" />
              Download PDF
            </a>
          )
        }
        <a href="/contact/" class="btn-ghost">
          Contact me
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="container-page grid gap-12 py-16 lg:grid-cols-[2fr_1fr]">
    <div class="space-y-14">
      <!-- Experience -->
      <div>
        <h2 class="flex items-center gap-3 text-xl font-semibold text-slate-100">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-accent/40 bg-accent/10 text-accent"
          >
            <Icon name="briefcase" class="h-4 w-4" />
          </span>
          Experience
        </h2>

        <ol class="mt-8 space-y-8 border-l border-line pl-6 sm:pl-8">
          {
            experiences.map((exp) => (
              <li class="relative">
                <span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-accent bg-base glow-dot sm:-left-[39px]" />
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-lg font-semibold text-slate-100">{exp.role}</h3>
                  <span class="font-mono text-xs text-accent">{exp.period}</span>
                </div>
                <p class="mt-0.5 text-sm text-slate-400">
                  {exp.company}
                  {exp.location && <span class="text-slate-500"> — {exp.location}</span>}
                </p>
                <ul class="mt-3 space-y-2">
                  {exp.missions.map((mission) => (
                    <li class="flex gap-2.5 text-sm leading-relaxed text-slate-400">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70" />
                      {mission}
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Education -->
      <div>
        <h2 class="flex items-center gap-3 text-xl font-semibold text-slate-100">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-accent/40 bg-accent/10 text-accent"
          >
            <Icon name="award" class="h-4 w-4" />
          </span>
          Education
        </h2>

        <ol class="mt-8 space-y-8 border-l border-line pl-6 sm:pl-8">
          {
            education.map((item) => (
              <li class="relative">
                <span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-blue bg-base sm:-left-[39px]" />
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-lg font-semibold text-slate-100">{item.degree}</h3>
                  <span class="font-mono text-xs text-accent">{item.period}</span>
                </div>
                <p class="mt-0.5 text-sm text-slate-400">{item.school}</p>
                {item.details && <p class="mt-2 text-sm text-slate-500">{item.details}</p>}
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Objective -->
      <div class="card p-6">
        <h2 class="text-lg font-semibold text-slate-100">Objective</h2>
        <div
          class="mt-3 max-w-none leading-relaxed text-slate-400 [&_a]:text-accent [&_strong]:text-slate-200"
        >
          <Content />
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="space-y-6">
      <div class="card p-6">
        <h2 class="font-mono text-xs uppercase tracking-widest text-accent">Languages</h2>
        <ul class="mt-4 space-y-3">
          {
            languages.map((lang) => (
              <li class="flex items-center justify-between gap-3 text-sm">
                <span class="text-slate-200">{lang.name}</span>
                <span class="text-right text-xs text-slate-500">{lang.level}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card p-6">
        <h2 class="font-mono text-xs uppercase tracking-widest text-accent">Interests</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            interests.map((interest) => (
              <li class="rounded-md border border-line bg-surface px-2.5 py-1 text-xs text-slate-300">
                {interest}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card p-6">
        <h2 class="font-mono text-xs uppercase tracking-widest text-accent">Contact</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex items-center gap-2.5 text-slate-400">
            <Icon name="map-pin" class="h-4 w-4 text-accent" />
            {site.location}
          </li>
          <li class="flex items-center gap-2.5 text-slate-400">
            <Icon name="mail" class="h-4 w-4 text-accent" />
            <a href={`mailto:${site.email}`} class="hover:text-accent">{site.email}</a>
          </li>
          <li class="flex items-center gap-2.5 text-slate-400">
            <Icon name="phone" class="h-4 w-4 text-accent" />
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-accent">
              {site.phoneDisplay}
            </a>
          </li>
        </ul>
        <a href="/contact/" class="btn-primary mt-5 w-full">
          Contact me
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </aside>
  </section>
</BaseLayout>
