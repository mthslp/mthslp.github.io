---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DownloadCard from '../components/DownloadCard.astro';
import { site } from '../data/site';
import fs from 'node:fs';
import path from 'node:path';

const docsDir = path.join(process.cwd(), 'public/docs');

const formatSize = (bytes: number) =>
  bytes < 1024 * 1024
    ? `${(bytes / 1024).toFixed(0)} KB`
    : `${(bytes / (1024 * 1024)).toFixed(1)} MB`;

const getDoc = (file: string) => {
  const full = path.join(docsDir, file);
  if (!fs.existsSync(full)) return null;
  return { href: `/docs/${file}`, size: formatSize(fs.statSync(full).size) };
};

const cv = getDoc('CV-Mathis-Le-Port.pdf');
---

<BaseLayout title="Documents" description="Download my CV in PDF format.">
  <section class="border-b border-line bg-surface">
    <div class="container-page py-14">
      <p class="font-mono text-sm uppercase tracking-widest text-accent">Downloads</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-100 sm:text-4xl">My documents</h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-slate-400">
        My CV in PDF format, ready to download, print or share.
      </p>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid gap-6 md:grid-cols-2">
      {
        cv ? (
          <DownloadCard
            title="CV — Mathis Le Port"
            description="Full background: experience, education, skills and languages."
            href={cv.href}
            size={cv.size}
            icon="file"
          />
        ) : (
          <div class="card border-dashed p-6">
            <h3 class="font-semibold text-slate-300">CV (PDF)</h3>
            <p class="mt-1 text-sm text-slate-500">
              Drop your file in{' '}
              <code class="font-mono text-accent">public/docs/CV-Mathis-Le-Port.pdf</code> to display it here.
            </p>
          </div>
        )
      }
    </div>

    <div class="card mt-10 flex flex-col items-start gap-5 p-8 sm:flex-row sm:items-center">
      <span
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-accent/40 bg-accent/10 text-accent"
      >
        <Icon name="file" class="h-6 w-6" />
      </span>
      <div class="flex-1">
        <h2 class="font-semibold text-slate-100">Prefer the online version?</h2>
        <p class="mt-1 text-sm text-slate-400">
          My CV is also available directly on the site, easy to browse and read.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/cv/" class="btn-ghost">View my CV online</a>
        <a href="/contact/" class="btn-primary">
          Contact me
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <p class="mt-8 text-center text-sm text-slate-500">
      A question about my CV?
      <a href={`mailto:${site.email}`} class="text-accent hover:underline">{site.email}</a>
    </p>
  </section>
</BaseLayout>
