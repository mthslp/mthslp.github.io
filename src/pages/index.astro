---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { getEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const skillsEntry = await getEntry('skills', 'skills');
const categories = skillsEntry?.data.categories ?? [];

const hasPhoto = fs.existsSync(path.join(process.cwd(), 'public/photo-profil.jpg'));
const hasCv = fs.existsSync(path.join(process.cwd(), 'public/docs/CV-Mathis-Le-Port.pdf'));

const cards = [
  {
    href: '/cv/',
    icon: 'briefcase',
    title: 'My CV',
    text: 'Experience, education and languages, presented online.',
  },
  {
    href: '/skills/',
    icon: 'bolt',
    title: 'IT skills',
    text: 'Technologies, environments and selected projects.',
  },
  {
    href: '/documents/',
    icon: 'download',
    title: 'Documents',
    text: 'Download my CV as a PDF, ready to print or share.',
  },
  {
    href: '/contact/',
    icon: 'mail',
    title: 'Contact',
    text: 'My details and a form to reach me quickly.',
  },
];
---

<BaseLayout title="Home">
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[720px] -translate-x-1/2 rounded-full bg-accent/10 blur-[120px]"
    >
    </div>
    <div
      class="pointer-events-none absolute right-0 top-1/3 h-72 w-72 rounded-full bg-blue/10 blur-[100px]"
    >
    </div>

    <div class="container-page relative grid items-center gap-12 py-20 lg:grid-cols-[1.4fr_1fr] lg:py-28">
      <div>
        <p
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-line bg-card/70 px-3 py-1 font-mono text-xs text-accent"
        >
          <span class="h-2 w-2 rounded-full bg-accent glow-dot"></span>
          Available for an engineering internship
        </p>

        <h1
          class="text-4xl font-bold leading-tight tracking-tight text-slate-100 sm:text-5xl lg:text-6xl"
        >
          Hi, I'm <span class="text-gradient">{site.name}</span>
        </h1>

        <p class="mt-4 font-mono text-lg text-slate-400 sm:text-xl">{site.role}</p>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-400 sm:text-lg">
          {site.tagline}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/cv/" class="btn-primary">
            View my CV
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          {
            hasCv ? (
              <a href="/docs/CV-Mathis-Le-Port.pdf" download class="btn-ghost">
                <Icon name="download" class="h-4 w-4" />
                Download PDF
              </a>
            ) : (
              <a href="/documents/" class="btn-ghost">
                <Icon name="download" class="h-4 w-4" />
                Documents
              </a>
            )
          }
        </div>

        <dl class="mt-10 grid max-w-xl grid-cols-3 gap-4 border-t border-line pt-6">
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-slate-500">Based in</dt>
            <dd class="mt-1 text-sm text-slate-200">{site.location}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-slate-500">Focus</dt>
            <dd class="mt-1 text-sm text-slate-200">Algorithms &amp; SE</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wider text-slate-500">Status</dt>
            <dd class="mt-1 text-sm text-slate-200">Ensimag — 2026</dd>
          </div>
        </dl>
      </div>

      <div class="mx-auto w-full max-w-sm">
        {
          hasPhoto ? (
            <div class="relative">
              <div class="absolute -inset-3 rounded-2xl bg-gradient-to-tr from-accent/30 to-blue/30 blur-xl" />
              <img
                src={site.photo}
                alt={`Photo of ${site.fullName}`}
                width="400"
                height="400"
                class="relative aspect-square w-full rounded-2xl border border-line object-cover"
              />
            </div>
          ) : (
            <div class="relative">
              <div class="absolute -inset-3 rounded-2xl bg-gradient-to-tr from-accent/30 to-blue/30 blur-xl" />
              <div class="relative flex aspect-square w-full items-center justify-center rounded-2xl border border-line bg-card">
                <span class="text-gradient text-7xl font-bold">{site.name.slice(0, 1)}</span>
              </div>
            </div>
          )
        }
        <div class="mt-4 flex justify-center gap-3">
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 rounded-lg border border-line px-3 py-2 text-sm text-slate-400 transition hover:border-accent/50 hover:text-accent"
          >
            <Icon name="mail" class="h-4 w-4" />
            Email
          </a>
          <a
            href={`tel:${site.phone.replace(/\s/g, '')}`}
            class="inline-flex items-center gap-2 rounded-lg border border-line px-3 py-2 text-sm text-slate-400 transition hover:border-accent/50 hover:text-accent"
          >
            <Icon name="phone" class="h-4 w-4" />
            Call
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTIONS -->
  <section class="container-page py-16">
    <h2 class="font-mono text-sm uppercase tracking-widest text-accent">Explore</h2>
    <p class="mt-2 text-2xl font-semibold text-slate-100">Everything you need to know about me</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        cards.map((card) => (
          <a href={card.href} class="card card-hover group flex h-full flex-col p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-lg border border-accent/40 bg-accent/10 text-accent transition group-hover:bg-accent group-hover:text-base">
              <Icon name={card.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 font-semibold text-slate-100 group-hover:text-accent">{card.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{card.text}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm text-accent">
              Open
              <Icon
                name="arrow-right"
                class="h-4 w-4 transition-transform group-hover:translate-x-1"
              />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- SKILLS PREVIEW -->
  <section class="border-y border-line bg-surface py-16">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-mono text-sm uppercase tracking-widest text-accent">Core stack</h2>
          <p class="mt-2 text-2xl font-semibold text-slate-100">A quick look at my skills</p>
        </div>
        <a href="/skills/" class="btn-ghost">
          See all
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-8 space-y-5">
        {
          categories.map((category) => (
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-5">
              <span class="w-44 shrink-0 font-mono text-xs uppercase tracking-wider text-slate-500">
                {category.name}
              </span>
              <ul class="flex flex-wrap gap-2">
                {category.items.map((item) => (
                  <li class="rounded-md border border-line bg-card px-2.5 py-1 font-mono text-sm text-slate-300">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-20">
    <div class="card relative overflow-hidden p-8 text-center sm:p-12">
      <div
        class="pointer-events-none absolute -top-24 left-1/2 h-64 w-96 -translate-x-1/2 rounded-full bg-accent/15 blur-[90px]"
      >
      </div>
      <div class="relative">
        <h2 class="text-2xl font-semibold text-slate-100 sm:text-3xl">
          A project or an opportunity?
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-slate-400">
          I'd be glad to talk with you. Feel free to get in touch — I usually reply within 24 hours.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href="/contact/" class="btn-primary">
            Contact me
            <Icon name="send" class="h-4 w-4" />
          </a>
          <a href="/documents/" class="btn-ghost">
            <Icon name="download" class="h-4 w-4" />
            Download my CV
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
